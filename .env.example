# Copie para `.env.local` e preencha com os dados do seu projeto Firebase.
# Sem estas variaveis o app roda 100% offline (localStorage) — nada quebra.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcionais
# Colecao onde os contadores sao gravados (padrao: counters)
VITE_FIREBASE_COLLECTION=counters
# Defina como "false" se as suas regras nao exigirem autenticacao
VITE_FIREBASE_ANONYMOUS_AUTH=true
